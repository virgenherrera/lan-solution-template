{
  "name": "shared-core",
  "version": "0.1.0",
  "description": "",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/db/sqlite/index.d.ts",
      "default": "./dist/db/sqlite/index.js"
    },
    "./pg": {
      "types": "./dist/db/pg/index.d.ts",
      "default": "./dist/db/pg/index.js"
    },
    "./tls": {
      "types": "./dist/tls/index.d.ts",
      "default": "./dist/tls/index.js"
    },
    "./tls/generate": {
      "types": "./dist/tls/generate.d.ts",
      "default": "./dist/tls/generate.js"
    }
  },
  "scripts": {
    "test": "pnpm run test:static && pnpm run test:dynamic",
    "build": "tsc -p tsconfig.json --rootDir src --outDir dist",
    "clean": "rimraf dist",
    "test:static": "tsc --noEmit -p tsconfig.json",
    "test:dynamic": "echo \"test:dynamic: not defined for this package\"",
    "package": "echo \"package: not defined for this package\""
  },
  "keywords": [],
  "author": "",
  "license": "PostgreSQL",
  "type": "module",
  "types": "dist/index.d.ts",
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "rimraf": "catalog:"
  },
  "dependencies": {
    "@nestjs/common": "catalog:nest",
    "@nestjs/config": "catalog:",
    "nestjs-zod": "catalog:",
    "pg": "catalog:",
    "rxjs": "catalog:",
    "service-registry": "workspace:*",
    "zod": "catalog:"
  },
  "private": true
}
