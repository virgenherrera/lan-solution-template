{
  "name": "desktop",
  "version": "0.0.1",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "test": "echo \"test: not defined for this package\"",
    "build": "cargo check --manifest-path src-tauri/Cargo.toml",
    "package": "tauri build --no-bundle"
  },
  "type": "module",
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4"
  },
  "nx": {
    "targets": {
      "build": {
