          {
            "projects": [
              "web-angular"
            ],
            "target": "build"
          }
        ]
      },
      "package": {
        "dependsOn": [
          {
            "projects": [
              "sea-runtime"
            ],
            "target": "package"
          },
          "build"
        ]
      }
    }
  }
