{
  "name": "desktop",
  "version": "0.1.0",
  "license": "PostgreSQL",
  "private": true,
  "scripts": {
    "test": "pnpm run test:static && pnpm run test:dynamic",
    "build": "node ../tools-cli/dist/main.js stage-sidecar && cargo check --manifest-path src-tauri/Cargo.toml",
    "package": "node ../../tools/scripts/e2e-desktop.ts && node ../tools-cli/dist/main.js stage-sidecar && tauri build --no-bundle && node ../tools-cli/dist/main.js installer-build",
    "test:static": "tsc --noEmit -p tsconfig.json",
    "test:dynamic": "echo \"test:dynamic: not defined for this package\""
  },
  "type": "module",
  "devDependencies": {
    "@tauri-apps/cli": "catalog:",
    "@types/node": "catalog:",
    "@wdio/cli": "catalog:",
    "@wdio/globals": "catalog:",
    "@wdio/local-runner": "catalog:",
    "@wdio/mocha-framework": "catalog:",
    "@wdio/spec-reporter": "catalog:",
    "@wdio/tauri-service": "catalog:",
    "typescript": "catalog:",
    "webdriverio": "catalog:"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          {
            "projects": [
              "sea-runtime"
            ],
            "target": "package"
          },
          {
            "projects": [
              "tools-cli"
            ],
            "target": "build"
          }
        ]
      },
      "package": {
        "dependsOn": [
          {
            "projects": [
              "sea-runtime"
            ],
            "target": "package"
          },
          {
            "projects": [
              "tools-cli"
            ],
            "target": "build"
          },
          "build",
          "test"
        ],
        "outputs": [
          "{projectRoot}/src-tauri/target/release"
        ],
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/tools/scripts/e2e-desktop.ts",
          "{workspaceRoot}/apps/tools-cli/src/**/*",
          "{workspaceRoot}/artifacts/sea-runtime/**/*",
          "{projectRoot}/installer/**/*",
          "{workspaceRoot}/libs/shared-core/config.example.json"
        ]
      }
    }
  }
}
