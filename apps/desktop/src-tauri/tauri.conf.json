{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LAN Solution Desktop",
  "version": "0.1.0",
  "identifier": "com.virgenherrera.lansolution",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    },
    "linux": {
      "deb": {
        "depends": ["libatomic1"]
      },
      "rpm": {
        "depends": ["libatomic"]
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "externalBin": ["binaries/sea-runtime"]
  }
}
