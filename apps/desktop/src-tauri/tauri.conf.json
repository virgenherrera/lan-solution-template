{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LAN Solution Desktop",
  "version": "0.1.0",
  "identifier": "com.virgenherrera.lansolution",
  "build": {
    "frontendDist": "../../web-angular/dist/web-angular/browser",
    "devUrl": "http://127.0.0.1:4200"
  },
  "app": {
    "windows": [
      {
        "title": "LAN Solution",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost blob: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    },
    "linux": {
      "deb": {
        "depends": ["libatomic1"]
      },
      "rpm": {
        "depends": ["libatomic"]
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
