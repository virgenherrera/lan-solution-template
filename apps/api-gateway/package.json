{
  "name": "api-gateway",
  "version": "0.1.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "PostgreSQL",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "clean": "rimraf dist",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "pnpm run test:static && pnpm run test:dynamic",
    "test:static": "tsc --noEmit -p tsconfig.json",
    "test:dynamic": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "package": "echo \"package: not defined for this package\""
  },
  "dependencies": {
    "@nestjs/common": "catalog:nest",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:nest",
    "@nestjs/platform-node": "catalog:nest",
    "@nestjs/terminus": "catalog:",
    "nestjs-zod": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "service-registry": "workspace:*",
    "shared-core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:nest",
    "@nestjs/mau": "catalog:nest",
    "@nestjs/schematics": "catalog:nest",
    "@nestjs/testing": "catalog:nest",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "jest": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "source-map-support": "catalog:",
    "supertest": "catalog:",
    "ts-jest": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}
