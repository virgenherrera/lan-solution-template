{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": {
      "type": "rspack",
      "options": {
        "configPath": "../../tools/rspack/nest.config.ts"
      }
    }
  }
}
