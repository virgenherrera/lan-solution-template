{
  "name": "sea-runtime",
  "version": "0.1.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "PostgreSQL",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "clean": "rimraf dist",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "pnpm run test:static && pnpm run test:dynamic",
    "test:static": "tsc --noEmit -p tsconfig.json",
    "test:dynamic": "echo \"test:dynamic: not defined for this package\""
  },
  "dependencies": {
    "@nestjs/common": "catalog:nest",
    "@nestjs/core": "catalog:nest",
    "db-migrations": "workspace:*",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "service-registry": "workspace:*",
    "shared-core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:nest",
    "@nestjs/schematics": "catalog:nest",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "api-gateway": "workspace:*",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "web-angular": "workspace:*"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "^build"
        ]
      },
      "package": {
        "dependsOn": [
          "build",
          "test",
          {
            "projects": "db-migrations",
            "target": "build"
          },
          {
            "projects": "tools-cli",
            "target": "build"
          }
        ],
        "executor": "nx:run-commands",
        "outputs": [
          "{workspaceRoot}/artifacts/sea-runtime"
        ],
        "options": {
          "command": "node apps/tools-cli/dist/main.js pack-migrations && node apps/tools-cli/dist/main.js compile-sea sea-runtime && node tools/scripts/smoke-sea.ts",
          "cwd": "{workspaceRoot}"
        },
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/libs/db-migrations/sqlite/migrations/**/*",
          "{workspaceRoot}/tools/scripts/smoke-sea.ts",
          "{workspaceRoot}/apps/tools-cli/src/**/*",
          "{workspaceRoot}/tools/rspack/**/*"
        ]
      },
      "smoke-pg": {
        "dependsOn": [
          "package"
        ],
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node tools/scripts/smoke-pg.ts",
          "cwd": "{workspaceRoot}"
        },
        "inputs": [
          "default",
          "{workspaceRoot}/tools/scripts/smoke-pg.ts",
          "{workspaceRoot}/libs/db-migrations/pg/migrations/**/*"
        ]
      }
    }
  }
}
