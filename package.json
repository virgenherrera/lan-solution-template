{
  "name": "lan-solution-template",
  "version": "0.0.1",
  "scripts": {
    "test": "node tools/scripts/test-filter.ts",
    "build": "nx run-many -t build --exclude=lan-solution-template",
    "package": "nx run-many -t package --exclude=lan-solution-template",
    "clean": "nx run-many -t clean --exclude=lan-solution-template && rimraf artifacts dist",
    "clean:all": "pnpm run clean && rimraf .nx/cache .nx/workspace-data \"apps/*/node_modules\" \"libs/*/node_modules\" node_modules",
    "dev:config": "node tools/scripts/init-dev-config.ts",
    "securityCheck": "pnpm audit --audit-level=high"
  },
  "license": "PostgreSQL",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "devDependencies": {
    "@rspack/core": "catalog:",
    "nx": "catalog:",
    "rimraf": "catalog:",
    "tsconfig-paths-webpack-plugin": "catalog:",
    "typescript": "catalog:",
    "webpack-node-externals": "catalog:",
    "zod": "catalog:"
  },
  "nx": {},
  "packageManager": "pnpm@12.16.1",
  "private": true
}
