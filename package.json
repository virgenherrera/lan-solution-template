{
  "name": "lan-solution-template",
  "version": "0.0.1",
  "scripts": {
    "test": "node tools/scripts/test-filter.ts",
    "build": "nx run-many -t build --exclude=lan-solution-template",
    "package": "nx run-many -t package --exclude=lan-solution-template",
    "clean": "nx run-many -t clean --exclude=lan-solution-template && rimraf artifacts dist",
    "clean:all": "pnpm run clean && rimraf .nx/cache .nx/workspace-data \"apps/*/node_modules\" \"libs/*/node_modules\" node_modules",
    "securityCheck": "pnpm audit --audit-level=high",
    "dev:gateway": "pnpm --filter api-gateway build && node apps/api-gateway/dist/main.js --web none",
    "dev:web": "NODE_EXTRA_CA_CERTS=\"$PWD/certs/ca.crt\" pnpm --filter web-angular exec ng serve",
    "dev:all": "pnpm --filter lan-solution-template --parallel run \"/^dev:(gateway|web)$/\""
  },
  "license": "PostgreSQL",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "devDependencies": {
    "@rspack/core": "catalog:",
    "nx": "catalog:",
    "rimraf": "catalog:",
    "tsconfig-paths-webpack-plugin": "catalog:",
    "typescript": "catalog:",
    "webpack-node-externals": "catalog:",
    "zod": "catalog:"
  },
  "nx": {},
  "packageManager": "pnpm@12.16.1",
  "private": true
}
