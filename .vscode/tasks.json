{
  // Build tasks for the launch configurations. Nothing here creates config/config.json on its own.
  "version": "2.0.0",
  "tasks": [
    {
      // Nx builds the libraries first (build dependsOn ^build), so this works from a clean checkout.
      "label": "Dev: build gateway",
      "type": "shell",
      "command": "pnpm exec nx run api-gateway:build",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      // Manual task: run it once on a new checkout. The runtime never creates the config and fails clearly when it is missing.
      "label": "Dev: config from example",
      "type": "shell",
      "command": "node -e \"const fs=require('fs');if(fs.existsSync('config/config.json')){console.log('config/config.json already exists: left untouched')}else{fs.mkdirSync('config',{recursive:true});fs.copyFileSync('libs/shared-core/config.example.json','config/config.json');console.log('created config/config.json from the example')}\"",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
