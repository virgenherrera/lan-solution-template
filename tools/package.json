{
  "name": "sea-build",
  "nx": {
    "targets": {
      "package": {
        "dependsOn": [
          {
            "dependencies": true,
            "target": "build"
          }
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "node tools/scripts/compile-sea.ts",
          "cwd": "{workspaceRoot}"
        }
      }
    },
    "implicitDependencies": [
      "*",
      "!lan-solution-template"
    ]
  },
  "type": "module",
  "private": true,
  "version": "0.0.1"
}
